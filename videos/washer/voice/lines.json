  "t0": 0.5,
  "t1": 2.684,
  "subs": [
   {
    "text": "नमस्ते दोस्तों! मैं हूँ गियरो!",
    "t0": 0.5,
    "t1": 2.634
   }
  ]
 },
 {
  "i": 1,
  "scene": 1,
  "t0": 2.984,
  "t1": 6.193,
  "subs": [
   {
    "text": "क्या आपने सोचा है,",
    "t0": 2.984,
    "t1": 4.188
   },
   {
    "text": "वॉशिंग मशीन कपड़े कैसे धोती है?",
    "t0": 4.188,
    "t1": 6.143
   }
  ]
 },
 {
  "i": 2,
  "scene": 2,
  "t0": 7.093,
  "t1": 10.994,
  "subs": [
   {
    "text": "मशीन के अंदर है एक ड्रम,",
    "t0": 7.093,
    "t1": 8.756
   },
   {
    "text": "जिसमें छोटे-छोटे छेद होते हैं।",
    "t0": 8.756,
    "t1": 10.944
   }
  ]
 },
 {
  "i": 3,
  "scene": 2,
  "t0": 11.294,
  "t1": 14.071,
  "subs": [
   {
    "text": "पीछे लगी मोटर",
    "t0": 11.294,
    "t1": 12.151
   },
   {
    "text": "बेल्ट से इस ड्रम को घुमाती है।",
    "t0": 12.151,
    "t1": 14.021
   }
  ]
 },
 {
  "i": 4,
  "scene": 3,
  "t0": 14.971,
  "t1": 18.669,
  "subs": [
   {
    "text": "पहले वाल्व से पानी अंदर आता है,",
    "t0": 14.971,
    "t1": 16.954
   },
   {
    "text": "और डिटर्जेंट घुल जाता है।",
    "t0": 16.954,
    "t1": 18.619
   }
  ]
 },
 {
  "i": 5,
  "scene": 3,
  "t0": 18.969,
  "t1": 23.014,
  "subs": [
   {
    "text": "ड्रम कपड़ों को ऊपर उठाकर गिराता है,",
    "t0": 18.969,
    "t1": 21.3
   },
   {
    "text": "इससे मैल निकल जाता है।",
    "t0": 21.3,
    "t1": 22.964
   }
  ]
 },
 {
  "i": 6,
  "scene": 4,
  "t0": 23.914,
  "t1": 27.72,
  "subs": [
   {
    "text": "आखिर में ड्रम बहुत तेज़ घूमता है—",
    "t0": 23.914,
    "t1": 25.792
   },
   {
    "text": "एक मिनट में हज़ार से ज़्यादा चक्कर!",
    "t0": 25.792,
    "t1": 27.67
   }
  ]
 },
 {
  "i": 7,
  "scene": 4,
  "t0": 28.02,
  "t1": 33.088,
  "subs": [
   {
    "text": "तेज़ घूमने से पानी छेदों से बाहर निकलता है,",
    "t0": 28.02,
    "t1": 31.048
   },
   {
    "text": "और पंप उसे बाहर फेंक देता है।",
    "t0": 31.048,
    "t1": 33.038
   }
  ]
 },
 {
  "i": 8,
  "scene": 5,
  "t0": 33.988,
  "t1": 34.877,
  "subs": [
   {
    "text": "ज़रूरी बातें!",
    "t0": 33.988,
    "t1": 34.827
   }
  ]
 },
 {
  "i": 9,
  "scene": 5,
  "t0": 35.177,
  "t1": 37.477,
  "subs": [
   {
    "text": "मशीन में ज़रूरत से ज़्यादा",
    "t0": 35.177,
    "t1": 36.574
   },
   {
    "text": "कपड़े न भरें।",
    "t0": 36.574,
    "t1": 37.427
   }
  ]
 },
 {
  "i": 10,
  "scene": 5,
  "t0": 37.777,
  "t1": 39.355,
  "subs": [
   {
    "text": "और फिल्टर हर महीने साफ करें।",
    "t0": 37.777,
    "t1": 39.305
   }
  ]
 },
 {
  "i": 11,
  "scene": 6,
  "t0": 40.255,
  "t1": 44.079,
  "subs": [
   {
    "text": "तो अगली बार कपड़े धोएँ,",
    "t0": 40.255,
    "t1": 41.814
   },
   {
    "text": "तो याद रखना— ये सब विज्ञान है!",
    "t0": 41.814,
    "t1": 44.029
   }
  ]
 },
 {
  "i": 12,
  "scene": 6,
  "t0": 44.429,
  "t1": 48.231,
  "subs": [
   {
